map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN};
    client_max_body_size 100m;

    root /usr/share/nginx/html;
    index index.html;

    # Monitor Glass 前端本体（SPA）
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache, must-revalidate";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 解锁服务端（sailor 上的小服务，数据为 IPQuality 报告解析结果）
    location /unlock/ {
        proxy_pass ${UNLOCK};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # design 校准服务端（本机小服务，数据落盘在 design-cal-data/cal.json）
    location /cal/ {
        proxy_pass ${CAL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 业务汇总服务端（本机小服务，数据落盘在 design-services-data/services.json）
    location /services/ {
        proxy_pass ${SERVICES};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Monitor Glass 适配层：面板首页快照（内含服务器列表与 PublicNote）
    location = /panel-snapshot {
        proxy_pass ${NEZHA};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # 登录入口：面板只认 <your-panel-domain> 一个 GitHub OAuth 回调，且登录
    # cookie 种在发起域名上——在本域名透传 /login 时回调落到主域名对不上
    # cookie，面板报「登录过程中发生错误」。故登录/后台一律整页跳主域名，
    # 让 cookie 与回调同域（落点与 v0 的机制一致）。
    location = /admin {
        return 302 https://<your-panel-domain>/login;
    }
    location = /admin/ {
        return 302 https://<your-panel-domain>/login;
    }

    # 哪吒 v0 实时数据（v190 的唯一后端通道）
    location /ws {
        proxy_pass ${NEZHA}ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }



    # 登录页与后台：同上，整页跳主域名（透传会因 OAuth cookie 跨域失败）
    location = /login {
        return 302 https://<your-panel-domain>/login;
    }
    location ^~ /dashboard {
        return 302 https://<your-panel-domain>/dashboard;
    }


    # 面板 OAuth 登录回调（GitHub 登录等）
    location ^~ /oauth2 {
        proxy_pass ${NEZHA_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 面板静态资源：渲染器 mixin.js、Vue/jQuery/echarts 都从这里加载
    location /static/ {
        proxy_pass ${NEZHA}static/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 保险：主题或后续版本可能用到的后端路径，透传给面板
    location /api/ {
        proxy_pass ${NEZHA}api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /service {
        proxy_pass ${NEZHA}service;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
