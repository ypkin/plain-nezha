{
  "name": "monitor-theme-design",
  "short": "Plain",
  "description": "Fork 自 stqfdyr/monitor-theme-serverstatus，融合 tweakcn 精选配色与 Zen Browser 噪点磨砂质感的现代化监控主题，支持深浅模式、实时换肤与无级质感微调",
  "version": "2.0.2",
  "author": "tom2almighty",
  "url": "https://github.com/ypkin/plain-nezha",
  "config": [
    { "type": "title", "label": "公告" },
    { "key": "notice", "type": "text", "label": "站点公告", "default": "", "help": "显示在首页顶部，纯文本展示，留空不显示" },
    { "type": "title", "label": "默认外观" },
    { "key": "theme_preset", "type": "select", "label": "默认配色方案", "default": "tz-dusk", "options": [
            { "value": "tz-ice", "label": "冰蓝" },
            { "value": "tz-crimson", "label": "绯红" },
            { "value": "tz-jade", "label": "翡翠" },
            { "value": "tz-amber", "label": "琥珀" },
            { "value": "tz-dusk", "label": "暮紫" },
            { "value": "tz-neon", "label": "霓虹" },
      { "value": "tz-carbon", "label": "碳黑" }
    ] },
    { "key": "grain_percent", "type": "number", "label": "默认噪点强度 (%)", "default": 16, "min": 0, "max": 100, "help": "Zen Browser 质感噪点颗粒强度（0-100%）" },
    { "key": "frosted_percent", "type": "number", "label": "默认磨砂透光度 (%)", "default": 20, "min": 0, "max": 100, "help": "卡片亚克力磨砂半透明度（0-100%）" }
  ]
}
